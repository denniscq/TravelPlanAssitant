# =============================================================================
# TravelPlanAssistant — environment variables template
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored, never commit it.
#
# Where to get the keys:
#   - AMap Web Service Key: https://lbs.amap.com/dev/key/app  ->  "Web服务" Key
#   - AMap JS API Key + securityJsCode: same console        ->  "Web端(JS API)" Key
#   - LLM Key: Anthropic https://console.anthropic.com  OR  Bailian https://bailian.console.aliyun.com
# =============================================================================

# --- AMap (required) ---------------------------------------------------------
AMAP_API_KEY=your_amap_web_service_key_here
NEXT_PUBLIC_AMAP_JS_API_KEY=your_amap_js_api_key_here
NEXT_PUBLIC_AMAP_JS_API_SECRET=your_amap_security_js_code_here

# --- LLM provider (required) -------------------------------------------------
# Choose ONE of the two providers below. Then set LLM_PROVIDER accordingly.
# To switch provider, change LLM_PROVIDER and the matching KEY/BASE_URL/MODEL vars.

# Option A — Anthropic-format (Anthropic proper, or MiniMax /anthropic endpoint)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M2.5-highspeed

# Option B — OpenAI-compatible (Bailian, OpenRouter, Together, ...)
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=deepseek-v4-flash

# Selects which adapter to use. Valid values: "anthropic" | "openai-compatible"
# Unknown values fall back to "openai-compatible" with a warning.
LLM_PROVIDER=anthropic

# --- Server-side rate limiting (optional, defaults shown) ---------------------
# Max requests per IP within the rate-limit window.
LLM_SERVICE_RATE_LIMIT_MAX=30
# Rate-limit window in milliseconds (default 1 hour).
LLM_SERVICE_RATE_LIMIT_WINDOW_MS=3600000

# --- Concurrency control (optional, defaults shown) --------------------------
# Max waiting requests allowed in the route-plan queue.
# Excess requests get HTTP 429 + Retry-After: 10.
ROUTE_PLAN_QUEUE_MAX_LENGTH=5

# --- POI search cache (optional, defaults shown) -----------------------------
# POI cache TTL in milliseconds (default 30 minutes).
POI_CACHE_TTL_MS=1800000